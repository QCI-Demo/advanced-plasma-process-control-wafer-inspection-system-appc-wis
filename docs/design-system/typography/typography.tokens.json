{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Tymeline CX Platform typography tokens (DS-TYPE-001 v1.0.0). Families approved from tymeline.app brand assets.",
  "meta": {
    "documentId": "DS-TYPE-001",
    "version": "1.0.0",
    "project": "Tymeline Customer Experience Platform",
    "brandSource": "https://tymeline.app/ CSS custom properties --serif, --sans, --mono",
    "wcagTarget": "AA"
  },
  "font": {
    "family": {
      "serif": {
        "value": "Fraunces, Georgia, 'Times New Roman', serif",
        "type": "fontFamily",
        "$description": "Brand display / marketing headings"
      },
      "sans": {
        "value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "type": "fontFamily",
        "$description": "Product UI headings, body, labels"
      },
      "mono": {
        "value": "JetBrains Mono, 'SF Mono', Menlo, Consolas, monospace",
        "type": "fontFamily",
        "$description": "Overlines, code, IDs, system meta"
      }
    },
    "weight": {
      "regular": { "value": 400, "type": "fontWeight" },
      "medium": { "value": 500, "type": "fontWeight" },
      "semibold": { "value": 600, "type": "fontWeight" },
      "bold": { "value": 700, "type": "fontWeight" }
    },
    "lineHeight": {
      "tight": { "value": 1.15, "type": "number" },
      "snug": { "value": 1.3, "type": "number" },
      "normal": { "value": 1.4, "type": "number" },
      "relaxed": { "value": 1.5, "type": "number" },
      "loose": { "value": 1.65, "type": "number" }
    },
    "letterSpacing": {
      "display": { "value": "-0.02em", "type": "dimension" },
      "heading": { "value": "-0.015em", "type": "dimension" },
      "none": { "value": "0", "type": "dimension" },
      "label": { "value": "0.01em", "type": "dimension" },
      "overline": { "value": "0.14em", "type": "dimension" }
    }
  },
  "text": {
    "display": {
      "sm": {
        "value": {
          "fontFamily": "{font.family.serif}",
          "fontSize": "2rem",
          "fontWeight": "{font.weight.medium}",
          "lineHeight": 1.15,
          "letterSpacing": "-0.02em"
        },
        "type": "typography",
        "$description": "In-app soft brand title / empty state"
      }
    },
    "heading": {
      "xl": {
        "value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "2rem",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1.25,
          "letterSpacing": "-0.02em"
        },
        "type": "typography",
        "$description": "Page title (H1)"
      },
      "lg": {
        "value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "1.5rem",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1.3,
          "letterSpacing": "-0.015em"
        },
        "type": "typography",
        "$description": "Section title (H2)"
      },
      "md": {
        "value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "1.25rem",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1.35,
          "letterSpacing": "-0.01em"
        },
        "type": "typography",
        "$description": "Subsection (H3)"
      },
      "sm": {
        "value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "1.125rem",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1.4,
          "letterSpacing": "-0.01em"
        },
        "type": "typography",
        "$description": "Card / list title (H4)"
      }
    },
    "body": {
      "lg": {
        "value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "1.125rem",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": 1.65,
          "letterSpacing": "0"
        },
        "type": "typography",
        "$description": "Emphasized body / lede"
      },
      "md": {
        "value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "1rem",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": 1.5,
          "letterSpacing": "0"
        },
        "type": "typography",
        "$description": "Default body — AA baseline"
      },
      "sm": {
        "value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "0.875rem",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": 1.5,
          "letterSpacing": "0"
        },
        "type": "typography",
        "$description": "Compact body / dense UI"
      }
    },
    "label": {
      "md": {
        "value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "0.875rem",
          "fontWeight": "{font.weight.medium}",
          "lineHeight": 1.4,
          "letterSpacing": "0.01em"
        },
        "type": "typography",
        "$description": "Form / control label"
      },
      "sm": {
        "value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "0.75rem",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": 1.35,
          "letterSpacing": "0.02em"
        },
        "type": "typography",
        "$description": "Chip / tab label"
      }
    },
    "caption": {
      "md": {
        "value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "0.75rem",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": 1.45,
          "letterSpacing": "0.01em"
        },
        "type": "typography",
        "$description": "Helper / caption — essential text floor"
      },
      "sm": {
        "value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "0.6875rem",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": 1.45,
          "letterSpacing": "0.01em"
        },
        "type": "typography",
        "$description": "Non-essential micro caption only"
      }
    },
    "overline": {
      "value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "0.6875rem",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": 1.3,
        "letterSpacing": "0.14em",
        "textTransform": "uppercase"
      },
      "type": "typography",
      "$description": "Short category eyebrow (≤ ~24 characters)"
    },
    "code": {
      "md": {
        "value": {
          "fontFamily": "{font.family.mono}",
          "fontSize": "0.875rem",
          "fontWeight": "{font.weight.medium}",
          "lineHeight": 1.5,
          "letterSpacing": "0"
        },
        "type": "typography"
      },
      "sm": {
        "value": {
          "fontFamily": "{font.family.mono}",
          "fontSize": "0.75rem",
          "fontWeight": "{font.weight.medium}",
          "lineHeight": 1.45,
          "letterSpacing": "0.02em"
        },
        "type": "typography"
      }
    },
    "brand": {
      "display": {
        "xl": {
          "value": {
            "fontFamily": "{font.family.serif}",
            "fontSize": "clamp(2.625rem, 5.4vw, 4.75rem)",
            "fontWeight": "{font.weight.medium}",
            "lineHeight": 1.02,
            "letterSpacing": "-0.028em"
          },
          "type": "typography",
          "$description": "Marketing hero H1 — brand site aligned"
        },
        "lg": {
          "value": {
            "fontFamily": "{font.family.serif}",
            "fontSize": "clamp(2rem, 3.8vw, 3.25rem)",
            "fontWeight": "{font.weight.medium}",
            "lineHeight": 1.08,
            "letterSpacing": "-0.024em"
          },
          "type": "typography"
        },
        "md": {
          "value": {
            "fontFamily": "{font.family.serif}",
            "fontSize": "1.5rem",
            "fontWeight": "{font.weight.medium}",
            "lineHeight": 1.25,
            "letterSpacing": "-0.018em"
          },
          "type": "typography"
        },
        "sm": {
          "value": {
            "fontFamily": "{font.family.serif}",
            "fontSize": "1.375rem",
            "fontWeight": "{font.weight.medium}",
            "lineHeight": 1.25,
            "letterSpacing": "-0.015em"
          },
          "type": "typography"
        }
      },
      "lede": {
        "value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "1.0625rem",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": 1.7,
          "letterSpacing": "0"
        },
        "type": "typography"
      }
    }
  },
  "accessibility": {
    "minBodyPx": 16,
    "minEssentialCaptionPx": 12,
    "minBodyLineHeight": 1.5,
    "wcagContrastNormal": 4.5,
    "wcagContrastLarge": 3.0,
    "textSpacingLineHeightFactor": 1.5,
    "maxBodyMeasureCh": 75,
    "notes": [
      "Use rem-based sizes for 200% zoom (WCAG 1.4.4).",
      "Body paragraphs require unitless line-height >= 1.5.",
      "Do not convey meaning with color or size alone.",
      "Tabular figures (tnum) recommended for timelines and numeric tables."
    ]
  }
}
